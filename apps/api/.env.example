# DevConnect API: local development settings.
# Copy this file to apps/api/.env (git-ignored). Never put real secrets in this example file.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Origin of the web app: allowed by CORS (later also used for OAuth redirects)
WEB_ORIGIN=http://localhost:3000

# How many reverse proxies sit in front of the API (0 locally; set when deploying)
TRUST_PROXY_HOPS=0

# --- Added in later phases (values match docker-compose.yml) ---
# DATABASE_URL=postgresql://devconnect:devconnect@localhost:5432/devconnect
# REDIS_URL=redis://localhost:6379
