# DevConnect API: local development settings.
# Copy this file to apps/api/.env (git-ignored). Never put real secrets in this example file.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Origin of the web app: allowed by CORS (later also used for OAuth redirects)
WEB_ORIGIN=http://localhost:3000

# How many reverse proxies sit in front of the API (0 locally; set when deploying)
TRUST_PROXY_HOPS=0

# PostgreSQL from docker-compose.yml (local-only credentials).
# 127.0.0.1 rather than localhost: Docker publishes the port on IPv4 only, and "localhost" makes
# Node try IPv6 (::1) first.
DATABASE_URL=postgresql://devconnect:devconnect@127.0.0.1:5432/devconnect

# Most database connections this process may open at once
DATABASE_POOL_MAX=10

# Redis from docker-compose.yml (rate-limit counters). Production: a rediss:// (TLS) URL.
REDIS_URL=redis://127.0.0.1:6379

# Signs access tokens. Must be 32+ random bytes, different in every environment, never committed.
# Generate one and paste it after the "=" (the app refuses to start while this is empty):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=

# Access-token lifetime in seconds (60-3600). Short, because an issued token can't be revoked.
JWT_ACCESS_TTL_SECONDS=900

# A refresh token unused for this many days expires (1-30). Each login lasts at most 30 days.
REFRESH_TOKEN_TTL_DAYS=7
